{
  "name": "ballpark-api",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 backend for Ballpark's anonymous daily score rankings.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ballpark --file=./schema.sql",
    "db:init:local": "wrangler d1 execute ballpark --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "wrangler": "^3.86.0"
  }
}
